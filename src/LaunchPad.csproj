<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>LaunchPad</AssemblyName>
    <RootNamespace>LaunchPad</RootNamespace>
    <ApplicationIcon>..\LaunchPad.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.2.3</Version>
    <Product>LaunchPad</Product>
    <AssemblyTitle>LaunchPad</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- One small .exe; uses the .NET 10 runtime already on the PC -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\LaunchPad.ico" LogicalName="LaunchPad.ico" />
  </ItemGroup>

</Project>
